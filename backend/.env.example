# Copy to backend/.env for local development. Never commit .env files.
# Every value below has a safe default; uncomment only what you need.

# development | test | production. Production refuses unsafe settings
# (draft lessons, demo user, wildcard/http CORS, missing encryption key, docs).
ENVIRONMENT=development
LOG_LEVEL=INFO
# DOCS_ENABLED=true            # /docs and /openapi.json; default: off in production

# --- Storage -----------------------------------------------------------------
DATABASE_PATH=data/netvalor.db
# Comma-separated Fernet keys; the first encrypts, the rest still decrypt (rotation).
# Generate one with: python -m app.cli generate-key   (required in production)
# DATA_ENCRYPTION_KEYS=

# --- Accounts ----------------------------------------------------------------
SESSION_TTL_HOURS=168
ALLOW_REGISTRATION=true
# Local demo account "alex" (development only). Needs a password of 12+ chars.
SEED_DEMO_USER=false
# DEMO_USER_PASSWORD=

# --- HTTP and abuse limits ------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
MAX_REQUEST_BYTES=65536
AUTH_RATE_LIMIT_PER_MINUTE=10
CHAT_RATE_LIMIT_PER_MINUTE=20
SEARCH_RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT_CHATS=4
MAX_CONCURRENT_CHATS_PER_USER=1

# --- Ollama --------------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen3.5:9b-q4_K_M
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=8192
LLM_NUM_PREDICT=700
LLM_READ_TIMEOUT_SECONDS=120
EMBEDDING_MODEL=embeddinggemma-2:270m

# --- Retrieval -----------------------------------------------------------------
CHROMA_DIR=data/chroma
# The starter lessons are unreviewed drafts. Set true only for local testing;
# answers built on drafts are labelled as such. Refused in production.
ALLOW_DRAFT=false
RETRIEVAL_K=4
MIN_RETRIEVAL_SCORE=0.35
